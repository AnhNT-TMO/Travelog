#!/bin/sh
# Đọc MỘT biến từ .env.production để .kamal/secrets nội suy vào.
#
#   bin/kamal-secret POSTGRES_PASSWORD
#
# Tồn tại vì .kamal/secrets nằm trong git: nó chỉ được chứa lệnh, không được
# chứa giá trị. Ưu tiên biến môi trường nếu đã export (bin/kamal truyền
# KAMAL_REGISTRY_PASSWORD vào theo đường đó), còn lại đọc từ file.
#
# POSIX sh, KHÔNG phải bash — script này chạy bên trong image
# ghcr.io/basecamp/kamal, và image đó là Alpine không có bash. Shebang
# /bin/bash làm mọi dòng $(bin/kamal-secret ...) trong .kamal/secrets trả về
# rỗng mà không báo gì, tức deploy với secret trống. Nên: không [[ ]], không
# ${!var}, không pipefail.
set -eu

key="${1:?Cách dùng: bin/kamal-secret <TÊN_BIẾN>}"
file="${KAMAL_ENV_FILE:-.env.production}"

# Đã export sẵn thì dùng luôn, khỏi cần file. printenv thay cho ${!key} của
# bash; busybox có sẵn applet này.
env_value="$(printenv "$key" 2>/dev/null || true)"
if [ -n "$env_value" ]; then
  printf '%s' "$env_value"
  exit 0
fi

if [ ! -f "$file" ]; then
  echo "kamal-secret: không thấy $file — xem 'Bước 3' trong infra/ec2/README.md để tạo." >&2
  exit 1
fi

# Dòng cuối cùng thắng, để ghi đè bằng cách append vào cuối file được.
# Cắt theo dấu = đầu tiên: mật khẩu có thể chứa dấu =.
value="$(grep -E "^${key}=" "$file" | tail -n 1 | cut -d= -f2-)"

# Bỏ dấu nháy nếu có, cho cả 'x' và "x".
value="${value%\"}"; value="${value#\"}"
value="${value%\'}"; value="${value#\'}"

if [ -z "$value" ]; then
  echo "kamal-secret: $key trống hoặc không có trong $file" >&2
  exit 1
fi

printf '%s' "$value"
