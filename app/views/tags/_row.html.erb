<%# Một dòng trong trang quản lý tag: đổi tên, chia sẻ, xoá.
    locals: tag %>
<div class="flex flex-wrap items-center gap-2.5 border-b border-line-soft px-3 py-2.5 last:border-b-0">
  <span class="h-[7px] w-[7px] flex-none rounded-full" style="background: <%= tag.color.presence || "var(--color-muted)" %>"></span>

  <%= link_to tag.name, places_tag_path(tag), class: "text-md font-semibold text-ink no-underline hover:text-primary" %>
  <span class="num text-xs text-muted"><%= tag.user_places_count %></span>

  <% if tag.shared? %>
    <span class="pill pill--visited"><%= t(".shared") %></span>
  <% end %>

  <span class="flex-1"></span>

  <% if tag.shared? %>
    <div data-controller="clipboard" class="flex items-center gap-1.5">
      <input type="text" readonly class="input num w-[15rem] text-2xs"
             value="<%= public_collection_url(tag.public_token) %>"
             data-clipboard-target="source">
      <button type="button" class="btn btn--sm" data-clipboard-target="button"
              data-action="clipboard#copy"><%= t(".copy_link") %></button>
    </div>
    <%= button_to t(".stop_sharing"), share_tag_path(tag), method: :patch,
          params: { enabled: "0" }, class: "btn btn--ghost btn--sm" %>
  <% else %>
    <%= button_to t(".start_sharing"), share_tag_path(tag), method: :patch,
          params: { enabled: "1" }, class: "btn btn--outline btn--sm",
          form: { data: { turbo_confirm: t(".start_sharing_confirm") } } %>
  <% end %>

  <%= link_to t(".edit"), edit_tag_path(tag), class: "btn btn--ghost btn--sm" %>
  <%= button_to t(".destroy"), tag_path(tag), method: :delete, class: "btn btn--ghost btn--sm",
        form: { data: { turbo_confirm: t(".destroy_confirm") } } %>
</div>
