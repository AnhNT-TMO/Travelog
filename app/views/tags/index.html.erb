<% content_for :title, "#{t(".title")} · #{t("app.name")}" %>
<% content_for :topbar_actions do %>
  <%= link_to t(".new_tag"), new_tag_path, class: "btn btn--primary btn--sm" %>
<% end %>
<% content_for :topbar do %>
  <%= render "shared/topbar", title: t(".title") %>
<% end %>

<div class="mx-auto flex max-w-[760px] flex-col gap-5">
  <% [ [ t("nav.group_area"), @area_tags ], [ t("nav.group_vibe"), @vibe_tags ] ].each do |heading, tags| %>
    <section>
      <div class="mb-2 flex items-baseline gap-2">
        <h3 class="text-md font-bold tracking-tight"><%= heading %></h3>
        <span class="num text-xs text-muted"><%= t("common.groups_count", count: tags.size) %></span>
      </div>

      <% if tags.any? %>
        <div class="flex flex-col overflow-hidden rounded-lg border border-line bg-surface">
          <% tags.each do |tag| %>
            <%= render "tags/row", tag: tag %>
          <% end %>
        </div>
      <% else %>
        <%= render "shared/empty", icon: "·", title: t(".empty_title"), description: t(".empty_description") %>
      <% end %>
    </section>
  <% end %>
</div>
