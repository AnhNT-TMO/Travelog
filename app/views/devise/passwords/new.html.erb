<h1 class="mb-4 text-lg font-bold tracking-tight"><%= t(".title") %></h1>

<%= form_with model: resource, scope: resource_name, url: password_path(resource_name), class: "flex flex-col gap-3" do |form| %>
  <div class="field">
    <%= form.label :email, t(".email"), class: "label" %>
    <%= form.email_field :email, autofocus: true, autocomplete: "email", class: "input", required: true %>
    <span class="hint"><%= t(".hint") %></span>
  </div>

  <%= form.submit t(".submit"), class: "btn btn--primary btn--block" %>
<% end %>

<p class="mt-3 text-xs text-muted">
  <%= link_to t(".back_to_sign_in"), new_session_path(resource_name), class: "text-primary" %>
</p>
