<h1 class="mb-4 text-lg font-bold tracking-tight"><%= t(".title") %></h1>

<%= form_with model: resource, scope: resource_name, url: session_path(resource_name), class: "flex flex-col gap-3" do |form| %>
  <div class="field">
    <%= form.label :email, t(".email"), class: "label" %>
    <%= form.email_field :email, autofocus: true, autocomplete: "email", class: "input", required: true %>
  </div>

  <div class="field">
    <%= form.label :password, t(".password"), class: "label" %>
    <%= form.password_field :password, autocomplete: "current-password", class: "input", required: true %>
  </div>

  <label class="flex items-center gap-2 text-sm text-ink-soft">
    <%= form.check_box :remember_me, checked: true %> <%= t(".remember_me") %>
  </label>

  <%= form.submit t(".submit"), class: "btn btn--primary btn--lg btn--block" %>
<% end %>

<p class="mt-3 text-xs text-muted">
  <%= link_to t(".forgot_password"), new_password_path(resource_name), class: "text-primary" %>
</p>
