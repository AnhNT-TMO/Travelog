<% content_for :title, "#{t(".title")} · #{t("app.name")}" %>
<% content_for :topbar do %>
  <%= render "shared/topbar", title: t(".title") %>
<% end %>

<% pending_count = @user_places.size %>
<% total_count   = pending_count + @reviewed_count %>
<% done_percent  = total_count.positive? ? (@reviewed_count * 100.0 / total_count).round : 100 %>

<div class="mx-auto flex max-w-[1180px] flex-col gap-3.5">
  <section class="flex flex-col gap-2.5 rounded-lg border border-line bg-surface px-3.5 py-3">
    <div class="flex flex-wrap items-end gap-x-4 gap-y-2">
      <div class="flex items-baseline gap-1.5">
        <span class="num text-2xl font-semibold <%= pending_count.positive? ? "text-ochre" : "text-primary" %>"><%= pending_count %></span>
        <span class="text-sm text-muted"><%= t(".pending_label") %></span>
      </div>
      <span class="num ml-auto text-xs text-muted">
        <%= t(".done_of_total", done: @reviewed_count, total: total_count) %>
      </span>
    </div>

    <div class="flex items-center gap-2">
      <div class="h-1.5 flex-1 overflow-hidden rounded-pill bg-surface-2" role="img"
           aria-label="<%= t(".progress_label", percent: done_percent) %>">
        <div class="h-full rounded-pill bg-primary transition-[width] duration-300 ease-brand"
             style="width: <%= done_percent %>%"></div>
      </div>
      <span class="num w-[2.6rem] text-right text-xs font-semibold text-primary"><%= done_percent %>%</span>
    </div>

    <span class="hint"><%= t(".oldest_first") %></span>
  </section>

  <% if @user_place.present? %>
    <div class="flex flex-col gap-3.5 lg:grid lg:grid-cols-[minmax(0,1fr)_318px] lg:items-start">
      <section class="overflow-hidden rounded-lg border border-line bg-surface lg:col-start-1">
        <%= render "reviews/workstation",
                   user_place: @user_place,
                   photos: @photos,
                   position: @position,
                   total: pending_count,
                   next_user_place: @next_user_place %>
      </section>

      <aside class="flex flex-col gap-2 rounded-lg border border-line bg-surface p-3 lg:col-start-2">
        <div class="flex items-baseline gap-2">
          <h3 class="text-md font-bold tracking-tight"><%= t(".queue") %></h3>
          <span class="num text-xs text-muted"><%= pending_count %></span>
        </div>

        <div class="flex flex-col gap-0.5 lg:max-h-[calc(100dvh-19rem)] lg:overflow-y-auto">
          <% @user_places.each_with_index do |user_place, index| %>
            <%= render "reviews/queue_row",
                       user_place: user_place,
                       index: index + 1,
                       active: user_place.id == @user_place.id %>
          <% end %>
        </div>

        <div class="h-px bg-line-soft"></div>
        <span class="hint"><%= t(".queue_hint") %></span>
      </aside>
    </div>
  <% else %>
    <%= render "shared/empty", icon: "✓", title: t(".empty_title"), description: t(".empty_description") %>
  <% end %>
</div>
