<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "#{t("devise.sessions.new.title")} · #{t("app.name")}" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#f2f4f2" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0d1211" media="(prefers-color-scheme: dark)">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="grid min-h-dvh place-items-center bg-ground p-4">
    <div class="w-full max-w-[380px]">
      <div class="mb-6 flex justify-center">
        <%= image_tag "logo.png", alt: t("app.name"), class: "h-24 w-24 object-contain" %>
      </div>

      <% flash.each do |type, message| %>
        <% next if message.blank? %>
        <div class="mb-3 rounded-md px-3 py-2 text-sm <%= type.to_s == "alert" ? "bg-lacquer-tint text-lacquer" : "bg-primary-tint text-primary" %>">
          <%= message %>
        </div>
      <% end %>

      <div class="rounded-lg border border-line bg-surface p-5 shadow-e1">
        <%= yield %>
      </div>

      <%= render "shared/locale_switch", css_class: "mt-4 justify-center" %>
    </div>
  </body>
</html>
