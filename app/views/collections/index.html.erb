<% content_for :title, "#{t(".title")} · #{t("app.name")}" %>
<% content_for :topbar_actions do %>
  <div class="order-last w-full sm:order-none sm:w-auto">
    <%= render "shared/search_field", width_class: "w-full sm:w-[220px] xl:w-[270px]" %>
  </div>
<% end %>
<% content_for :topbar do %>
  <%= render "shared/topbar", title: t(".title") %>
<% end %>

<div class="flex flex-col gap-5">
  <% if @tags.any? %>
    <section>
      <div class="mb-2 flex items-baseline gap-2">
        <h3 class="text-md font-bold tracking-tight"><%= t(".by_tag") %></h3>
        <span class="num text-xs text-muted"><%= t("common.tags_count", count: @group_counts[:tags]) %></span>
        <%= link_to t(".manage_tags"), tags_path, class: "ml-auto text-sm font-semibold text-primary no-underline" %>
      </div>

      <%= render "collections/collection_grid", tags: @tags, counts_by_tag: @counts_by_tag,
                 covers_by_tag: @collection_covers_by_tag %>

      <% if @group_counts[:tags] > @tags.size %>
        <%= render "collections/see_all", path: tags_collections_path,
                   label: t(".see_all_tags", count: @group_counts[:tags]) %>
      <% end %>
    </section>
  <% end %>

  <% if @untagged_places.any? %>
    <section>
      <div class="mb-1 flex items-baseline gap-2">
        <h3 class="text-md font-bold tracking-tight"><%= t("nav.group_untagged") %></h3>
        <span class="num text-xs text-muted"><%= t("common.places_count", count: @group_counts[:untagged]) %></span>
      </div>
      <p class="mb-2 text-sm text-muted"><%= t(".untagged_hint") %></p>

      <div class="rounded-lg border border-line bg-surface p-1">
        <%= render "shared/place_row_list", user_places: @untagged_places %>
      </div>

      <% if @group_counts[:untagged] > @untagged_places.size %>
        <%= render "collections/see_all", path: untagged_collections_path,
                   label: t(".see_all_places", count: @group_counts[:untagged]) %>
      <% end %>
    </section>
  <% end %>
</div>
