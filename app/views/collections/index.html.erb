<% content_for :title, "#{t(".title")} · #{t("app.name")}" %>
<% content_for :topbar_actions do %>
  <div class="hidden sm:block"><%= render "shared/search_field" %></div>
  <%= link_to t(".add_place"), new_place_path, class: "btn btn--primary btn--sm" %>
<% end %>
<% content_for :topbar do %>
  <%= render "shared/topbar", title: t(".title") %>
<% end %>

<div class="flex flex-col gap-5">
  <% [[t(".by_area"), @area_tags], [t(".by_vibe"), @vibe_tags]].each do |heading, tags| %>
    <% next if tags.empty? %>
    <section>
      <div class="mb-2 flex items-baseline gap-2">
        <h3 class="text-md font-bold tracking-tight"><%= heading %></h3>
        <span class="num text-xs text-muted"><%= t("common.groups_count", count: tags.size) %></span>
        <%= link_to t(".manage_tags"), tags_path, class: "ml-auto text-sm font-semibold text-primary no-underline" %>
      </div>
      <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-3 xl:grid-cols-4">
        <% tags.each do |tag| %>
          <%= render "shared/collection_card", tag: tag, counts: @counts_by_tag[tag.id],
                     cover: @collection_covers_by_tag[tag.id] %>
        <% end %>
      </div>
    </section>
  <% end %>

  <section>
    <div class="mb-2 flex items-baseline gap-2">
      <h3 class="text-md font-bold tracking-tight"><%= t(".recent") %></h3>
      <span class="num text-xs text-muted"><%= t("common.places_pending", count: @recent_places.size) %></span>
      <%= link_to t(".see_all"), places_path, class: "ml-auto text-sm font-semibold text-primary no-underline" %>
    </div>
    <%= render "shared/place_grid", user_places: @recent_places %>
  </section>
</div>
