<% content_for :title, "#{t("nav.group_untagged")} · #{t("app.name")}" %>
<% content_for :topbar_actions do %>
<% end %>
<% content_for :topbar do %>
  <%= render "shared/topbar", title: t("nav.group_untagged"), crumb: t("nav.collections") %>
<% end %>

<div class="flex flex-col gap-3.5">
  <%= render "collections/group_nav", current: "untagged", counts: @group_counts %>

  <% if @user_places.any? %>
    <p class="text-sm text-muted"><%= t(".hint") %></p>
  <% end %>

  <div class="rounded-lg border border-line bg-surface p-1">
    <%= render "shared/place_row_list", user_places: @user_places,
               empty_icon: "✓", empty_title: t(".empty_title"),
               empty_description: t(".empty_description") %>
  </div>
</div>
