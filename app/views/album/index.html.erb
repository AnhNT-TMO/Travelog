<% content_for :title, "#{t(".title")} · #{t("app.name")}" %>
<% content_for :topbar do %>
  <%= render "shared/topbar", title: t(".title"),
             title_class: "font-serif text-xl font-normal italic" %>
<% end %>

<div class="flex flex-col gap-3">
  <%= form_with url: album_path, method: :get, class: "flex flex-wrap items-end gap-2.5 rounded-md border border-line bg-surface p-3" do |form| %>
    <div class="field">
      <%= form.label :from, t(".from"), class: "label" %>
      <%= form.date_field :from, value: @from, class: "input" %>
    </div>
    <div class="field">
      <%= form.label :to, t(".to"), class: "label" %>
      <%= form.date_field :to, value: @to, class: "input" %>
    </div>
    <%= form.submit t(".submit"), class: "btn btn--outline" %>
    <span class="flex-1"></span>
    <button type="button" class="btn" disabled title="<%= t(".export_pdf_title") %>">
      <%= t(".export_pdf") %>
      <span class="pill pill--soon"><%= t(".export_pdf_badge") %></span>
    </button>
  <% end %>

  <div class="flex max-w-[760px] flex-col gap-4">
  <% if @by_month.any? %>
    <% @by_month.each do |month, visits| %>
      <section>
        <div class="sticky top-0 z-[1] mb-2 bg-ground pb-2
                    before:absolute before:inset-x-0 before:bottom-full before:h-3.5 before:bg-ground">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 rounded-md border border-line bg-surface px-3 py-2 shadow-e1">
            <span aria-hidden="true" class="h-5 w-[3px] flex-none rounded-pill bg-primary"></span>
            <h2 class="font-serif text-xl italic leading-none"><%= month_label(month) %></h2>
            <span class="num text-sm font-semibold text-muted"><%= month.year %></span>
            <span class="flex-1"></span>
            <span class="num text-xs font-semibold text-ink-soft">
              <%= t("common.places_count", count: visits.map(&:user_place_id).uniq.size) %>
            </span>
            <span aria-hidden="true" class="text-xs text-line">·</span>
            <span class="num text-xs font-semibold text-ink-soft">
              <%= t("common.photos_count", count: visits.sum { |visit| @photos_by_visit[visit].size }) %>
            </span>
          </div>
        </div>

        <% visits.each do |visit| %>
          <div class="grid grid-cols-[6.4rem_1fr] gap-3 border-t border-line-soft py-2.5">
            <div class="num text-xs leading-tight text-ink-soft">
              <b class="block text-xl font-semibold text-ink"><%= visit.visited_at.day %></b>
              <%= l visit.visited_at, format: :album %>
            </div>

            <div>
              <div class="mb-1.5 text-md font-semibold">
                <%= visit.user_place.label %>
                <% if visit.user_place.place.district.present? %>
                  <span class="text-sm font-normal text-muted">· <%= visit.user_place.place.district %></span>
                <% end %>
              </div>
              <% if @photos_by_visit[visit].any? %>
                <div class="grid grid-cols-[repeat(auto-fill,minmax(76px,1fr))] gap-1">
                  <% @photos_by_visit[visit].each do |photo| %>
                    <div class="media-skeleton aspect-square overflow-hidden rounded-sm">
                      <%= photo_image_tag photo, sizes: "96px", srcset: false %>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </section>
    <% end %>
  <% else %>
    <%= render "shared/empty",
               icon: "▤",
               title: t(".empty_title"),
               description: t(".empty_description") %>
  <% end %>
  </div>
</div>
