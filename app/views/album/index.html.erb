<% content_for :title, "#{t(".title")} · #{t("app.name")}" %>
<% content_for :topbar do %>
  <%# Newsreader italic chỉ xuất hiện ở album — phần duy nhất của app mang
      tính kỷ niệm chứ không phải công cụ. %>
  <%= render "shared/topbar", title: t(".title"),
             title_class: "font-serif text-xl font-normal italic" %>
<% end %>

<div class="flex flex-col gap-3">
  <%= form_with url: album_path, method: :get, class: "flex flex-wrap items-end gap-2.5 rounded-md border border-line bg-surface p-3" do |form| %>
    <div class="field">
      <%= form.label :from, t(".from"), class: "label" %>
      <%= form.date_field :from, value: @from, class: "input" %>
    </div>
    <div class="field">
      <%= form.label :to, t(".to"), class: "label" %>
      <%= form.date_field :to, value: @to, class: "input" %>
    </div>
    <%= form.submit t(".submit"), class: "btn btn--outline" %>
    <span class="flex-1"></span>
    <%# Để nút này HIỆN và disabled, đừng ẩn — chủ dự án cần thấy nó ở đó. %>
    <button type="button" class="btn" disabled title="<%= t(".export_pdf_title") %>"><%= t(".export_pdf") %></button>
  <% end %>

  <%# Album đọc như một cuốn sổ: cột hẹp, không trải hết bề ngang màn hình. %>
  <div class="max-w-[760px]">
  <% if @by_month.any? %>
    <% @by_month.each do |month, visits| %>
      <section>
        <div class="num sticky top-0 z-[1] bg-ground py-1.5 text-xs uppercase tracking-[0.1em] text-muted">
          <%= t(".month_summary", month: month_label(month),
                        places: visits.map(&:user_place_id).uniq.size,
                        photos: visits.sum { |visit| @photos_by_visit[visit].size }) %>
        </div>

        <% visits.each do |visit| %>
          <div class="grid grid-cols-[5.6rem_1fr] gap-3 border-t border-line-soft py-2.5">
            <div class="num text-xs leading-tight text-ink-soft">
              <b class="block text-xl font-semibold text-ink"><%= visit.visited_at.day %></b>
              <%= l visit.visited_at, format: :album %>
            </div>

            <div>
              <div class="mb-1.5 text-md font-semibold">
                <%= visit.user_place.label %>
                <% if visit.user_place.place.district.present? %>
                  <span class="text-sm font-normal text-muted">· <%= visit.user_place.place.district %></span>
                <% end %>
              </div>
              <% if @photos_by_visit[visit].any? %>
                <div class="grid grid-cols-[repeat(auto-fill,minmax(76px,1fr))] gap-1">
                  <% @photos_by_visit[visit].each do |photo| %>
                    <div class="media-skeleton aspect-square overflow-hidden rounded-sm">
                      <%= photo_image_tag photo, sizes: "96px", srcset: false %>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </section>
    <% end %>
  <% else %>
    <%= render "shared/empty",
               icon: "▤",
               title: t(".empty_title"),
               description: t(".empty_description") %>
  <% end %>
  </div>
</div>
