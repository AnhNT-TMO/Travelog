<%# no locals %>
<div data-tag-sheet-target="panel" hidden
     data-action="keydown->tag-sheet#closeOnEscape"
     class="fixed inset-0 z-30 flex items-end justify-center lg:items-center">

  <button type="button" class="absolute inset-0 bg-black/40" aria-label="<%= t(".close") %>"
          data-action="tag-sheet#close"></button>

  <div class="relative flex max-h-[86vh] w-full flex-col gap-2.5 overflow-y-auto rounded-t-[18px] border-t border-line bg-surface px-3.5 pb-4 pt-3 shadow-e3
              lg:max-w-[440px] lg:rounded-lg lg:border">
    <span class="mx-auto h-1 w-[34px] flex-none rounded-sm bg-surface-3 lg:hidden"></span>
    <span class="text-md font-bold"><%= t(".title") %></span>

    <div id="tag_sheet_errors"></div>

    <%= form_with url: quick_create_tags_path, scope: :tag, class: "flex flex-col gap-2.5",
                  data: {
                    tag_sheet_target: "form",
                    action: "turbo:submit-end->tag-sheet#closeOnSuccess"
                  } do |form| %>
      <div class="field">
        <%= form.label :name, t(".name"), class: "label" %>
        <%= form.text_field :name, class: "input", required: true, placeholder: t(".name_placeholder"),
              data: { tag_sheet_target: "name" } %>
      </div>

      <div class="field">
        <span class="label"><%= t(".kind") %></span>
        <div class="seg w-full">
          <% Tag.kinds.keys.each do |value| %>
            <label class="seg-item flex-1 justify-center has-[:checked]:bg-surface has-[:checked]:text-ink has-[:checked]:shadow-e1">
              <%= form.radio_button :kind, value, class: "sr-only", data: { tag_sheet_target: "kind" } %>
              <%= t("tag_kind.#{value}") %>
            </label>
          <% end %>
        </div>
      </div>

      <div class="field">
        <%= form.label :color, t(".color"), class: "label" %>
        <%= form.color_field :color, value: "#0E6E63", class: "input-color" %>
      </div>

      <div class="flex gap-2">
        <button type="button" class="btn btn--ghost flex-none" data-action="tag-sheet#close"><%= t(".cancel") %></button>
        <%= form.submit t(".submit"), class: "btn btn--primary btn--lg flex-1" %>
      </div>
    <% end %>
  </div>
</div>
