<%# locals: form, user_place, tags %>
<% selected = user_place.tag_ids.map(&:to_s) %>

<div class="flex flex-col gap-2">
  <div class="flex flex-wrap items-center gap-1.5">
    <div id="tag_options" class="contents">
      <% tags.each do |tag| %>
        <%= render "places/tag_option", tag: tag, checked: selected.include?(tag.id.to_s) %>
      <% end %>
    </div>
    <button type="button" class="chip border-dashed text-muted" data-action="tag-sheet#open">
      <%= t(".add") %>
    </button>
  </div>

  <%= hidden_field_tag "user_place[tag_ids][]", "" %>
</div>
