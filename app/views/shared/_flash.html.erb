<% if flash.any? %>
  <div class="pointer-events-none fixed inset-x-0 top-2.5 z-40 flex flex-col items-center gap-1.5 px-3.5">
    <% flash.each do |type, message| %>
      <% next if message.blank? %>
      <div data-controller="flash"
           class="pointer-events-auto inline-flex max-w-full items-center gap-2 rounded-md px-3 py-2 text-sm shadow-e2 <%= type.to_s == "alert" ? "bg-lacquer-tint text-lacquer" : "bg-ink text-ground" %>">
        <span><%= message %></span>
        <button type="button" class="-mr-1 shrink-0 cursor-pointer px-1 text-base leading-none opacity-70 hover:opacity-100"
                aria-label="<%= t(".dismiss") %>" data-action="flash#dismiss">×</button>
      </div>
    <% end %>
  </div>
<% end %>
