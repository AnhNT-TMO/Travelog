<% if flash.any? %>
  <div class="flex flex-col gap-1.5 px-3.5 pt-3.5">
    <% flash.each do |type, message| %>
      <% next if message.blank? %>
      <div class="inline-flex items-center gap-2 rounded-md px-3 py-2 text-sm shadow-e2 <%= type.to_s == "alert" ? "bg-lacquer-tint text-lacquer" : "bg-ink text-ground" %>">
        <span><%= message %></span>
      </div>
    <% end %>
  </div>
<% end %>
