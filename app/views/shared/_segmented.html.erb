<%# Segmented control 3 trạng thái + số đếm (D6). State nằm trong URL (?state=)
    để bookmark và back/forward hoạt động. Điều hướng cấp trang để server render
    lại cả control lẫn danh sách; Stimulus chỉ phản hồi selected ngay lúc click.
    locals: current, counts, base_params, url %>
<div class="seg" role="tablist" data-controller="segmented">
  <% %w[wishlist visited all].each do |value| %>
    <%= link_to url_for(base_params.merge(state: value)),
          role: "tab",
          "aria-selected": (current.to_s == value).to_s,
          class: "seg-item",
          data: { action: "click->segmented#select" } do %>
      <%= t("filters.state.#{value}") %>
      <span class="num"><%= counts[value.to_sym] %></span>
    <% end %>
  <% end %>
</div>
