<div class="seg" role="tablist" data-controller="segmented">
  <% %w[wishlist visited all].each do |value| %>
    <%= link_to url_for(base_params.merge(state: value)),
          role: "tab",
          "aria-selected": (current.to_s == value).to_s,
          class: "seg-item",
          data: { action: "click->segmented#select" } do %>
      <%= t("filters.state.#{value}") %>
      <span class="num"><%= counts[value.to_sym] %></span>
    <% end %>
  <% end %>
</div>
