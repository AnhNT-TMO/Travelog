<%# locals: title, description: nil, icon: "◎" %>
<% icon        = local_assigns.fetch(:icon, "◎") %>
<% description = local_assigns.fetch(:description, nil) %>

<div class="flex flex-col items-center gap-1.5 px-4 py-8 text-center">
  <span class="grid h-[42px] w-[42px] place-items-center rounded-full bg-surface-2 text-lg text-muted"><%= icon %></span>
  <span class="text-md font-semibold text-ink"><%= title %></span>
  <% if description.present? %>
    <span class="max-w-[30ch] text-sm text-muted"><%= description %></span>
  <% end %>
</div>
