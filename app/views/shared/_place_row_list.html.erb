<%# locals: user_places, numbered (optional), empty_icon (optional), empty_title (optional), empty_description (optional) %>
<% numbered          = local_assigns.fetch(:numbered, false) %>
<% empty_icon        = local_assigns.fetch(:empty_icon, "⌖") %>
<% empty_title       = local_assigns.fetch(:empty_title, t(".empty_title")) %>
<% empty_description = local_assigns.fetch(:empty_description, t(".empty_description")) %>
<%= turbo_frame_tag "place_list" do %>
  <% if user_places.any? %>
    <div class="flex flex-col gap-0.5">
      <% user_places.each_with_index do |user_place, index| %>
        <%= render "shared/place_row", user_place: user_place,
                   index: (numbered ? index + 1 : nil) %>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/empty",
               icon: empty_icon,
               title: empty_title,
               description: empty_description %>
  <% end %>
<% end %>
