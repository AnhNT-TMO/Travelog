<div class="flex flex-col">
  <% visits.each_with_index do |visit, index| %>
    <div class="grid grid-cols-[1.1rem_1fr] gap-x-2.5">
      <div class="relative">
        <div class="h-[11px] w-[11px] rounded-full border-2 border-primary bg-surface mt-1.5"></div>
        <% unless index == visits.size - 1 %>
          <span class="absolute bottom-[-6px] left-[5px] top-4 w-px bg-line"></span>
        <% end %>
      </div>

      <div class="flex flex-col gap-1 pb-3.5">
        <span class="num text-xs text-muted"><%= l visit.visited_at, format: :long %></span>
        <% if visit.note.present? %>
          <span class="text-sm font-semibold"><%= visit.note %></span>
        <% end %>
        <% if visit.companions.present? %>
          <span class="text-xs text-muted"><%= t(".companions", names: visit.companions) %></span>
        <% end %>

        <% if visit.photos.any? %>
          <div class="flex gap-1">
            <% visit.photos.first(6).each do |photo| %>
              <div class="media-skeleton h-[46px] w-[46px] overflow-hidden rounded-sm">
                <%= photo_image_tag photo, sizes: "46px" %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
