<% badge = local_assigns.fetch(:badge, nil) %>

<%= link_to path,
      "aria-current": (current ? "page" : nil),
      class: "flex flex-1 flex-col items-center gap-0.5 text-2xs no-underline " +
             (current ? "font-semibold text-primary" : "text-muted") do %>
  <span class="relative text-lg leading-none">
    <%= icon %>
    <% if badge.present? %>
      <span class="num absolute -right-2.5 -top-1 grid h-[15px] min-w-[15px] place-items-center rounded-pill bg-ochre px-1 text-2xs font-semibold leading-none text-on-primary"><%= badge %></span>
    <% end %>
  </span>
  <%= label %>
<% end %>
