<%= link_to path,
      "aria-current": (current ? "page" : nil),
      class: "flex flex-1 flex-col items-center gap-0.5 text-2xs no-underline " +
             (current ? "font-semibold text-primary" : "text-muted") do %>
  <span class="text-lg leading-none"><%= icon %></span>
  <%= label %>
<% end %>
