<%# Card bộ sưu tập ở trang chủ — mockup D1. Cover lấy tự động từ ảnh mới nhất
    trong nhóm, không cần người dùng chọn.
    locals: tag, counts %>
<% cover = tag.user_places.with_card_data.order(created_at: :desc).detect { |up| up.cover_photo.present? } %>

<%= link_to places_tag_path(tag),
      class: "relative flex aspect-[3/2] cursor-pointer flex-col justify-end overflow-hidden rounded-lg border border-line no-underline" do %>
  <div class="media-skeleton absolute inset-0" style="<%= placeholder_gradient_style(tag.name) if cover.blank? %>">
    <%= photo_image_tag(cover.cover_photo, sizes: "(max-width: 640px) 45vw, 260px") if cover.present? %>
  </div>

  <span class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-black/70"></span>

  <div class="relative flex flex-col gap-0.5 px-2.5 pb-2.5">
    <span class="text-md font-bold tracking-tight text-white [text-shadow:0_1px_3px_rgba(0,0,0,.5)]"><%= tag.name %></span>
    <span class="num flex gap-2 text-2xs text-white/90 [&_b]:font-semibold">
      <span><%= t(".counts_html", wishlist: counts[:wishlist]) %></span>
      <span><%= t(".visited_html", visited: counts[:visited]) %></span>
    </span>
  </div>
<% end %>
