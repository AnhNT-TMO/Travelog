# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*
!/.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key


/app/assets/builds/*
!/app/assets/builds/.keep

# Terraform — state chứa access key và webhook secret.
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/terraform.tfvars
infra/terraform/*.zip
infra/terraform/.terraform.lock.hcl

# Lambda build output
infra/lambda/node_modules/

# Kamal secrets — registry password, RAILS_MASTER_KEY, AWS keys.
# Chỉ template được commit.
/.kamal/secrets*
!/.kamal/secrets.example

# Terraform workspace state — cùng lý do với *.tfstate ở trên.
infra/terraform/terraform.tfstate.d/

# Agent config riêng của máy (skill trong .claude/ và .codex/ thì vẫn commit).
.claude/settings.local.json
.codex/settings.local.json
